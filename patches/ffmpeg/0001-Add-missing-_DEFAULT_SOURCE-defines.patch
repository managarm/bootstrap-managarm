From 2b3889fbc8b66d1013116b5cfb5d7833bb0adcfc Mon Sep 17 00:00:00 2001
From: Dennis Bonke <admin@dennisbonke.com>
Date: Mon, 14 Sep 2026 14:52:46 +0200
Subject: [PATCH] Add missing _DEFAULT_SOURCE defines

---
 fftools/ffmpeg.c      | 2 ++
 fftools/ffmpeg_opt.c  | 2 ++
 libavfilter/ebur128.c | 2 ++
 libavutil/time.c      | 2 ++
 libswscale/filters.c  | 2 ++
 5 files changed, 10 insertions(+)

diff --git a/fftools/ffmpeg.c b/fftools/ffmpeg.c
index b394243..1912580 100644
--- a/fftools/ffmpeg.c
+++ b/fftools/ffmpeg.c
@@ -25,6 +25,8 @@
 
 #include "config.h"
 
+#define _DEFAULT_SOURCE
+
 #include <errno.h>
 #include <limits.h>
 #include <stdatomic.h>
diff --git a/fftools/ffmpeg_opt.c b/fftools/ffmpeg_opt.c
index 2c362c6..8ef4d14 100644
--- a/fftools/ffmpeg_opt.c
+++ b/fftools/ffmpeg_opt.c
@@ -18,6 +18,8 @@
  * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
  */
 
+#define _DEFAULT_SOURCE
+
 #include "config.h"
 
 #include <stdint.h>
diff --git a/libavfilter/ebur128.c b/libavfilter/ebur128.c
index 062099e..227c22f 100644
--- a/libavfilter/ebur128.c
+++ b/libavfilter/ebur128.c
@@ -41,6 +41,8 @@
  * THE SOFTWARE.
 */
 
+#define _DEFAULT_SOURCE
+
 #include "ebur128.h"
 
 #include <float.h>
diff --git a/libavutil/time.c b/libavutil/time.c
index 740afc4..5a8119f 100644
--- a/libavutil/time.c
+++ b/libavutil/time.c
@@ -18,6 +18,8 @@
  * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
  */
 
+#define _DEFAULT_SOURCE
+
 #include "config.h"
 
 #include <stddef.h>
diff --git a/libswscale/filters.c b/libswscale/filters.c
index fb54d2b..6359090 100644
--- a/libswscale/filters.c
+++ b/libswscale/filters.c
@@ -18,6 +18,8 @@
  * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
  */
 
+#define _DEFAULT_SOURCE
+
 #include <math.h>
 #include <stdbool.h>
 
